generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  price       Float
  imageUrl    String
  category    String
  createdAt   DateTime @default(now())
}

model Hotel {
  id             Int      @id @default(autoincrement())
  name           String
  location       String
  description    String
  googleRating   Float    @default(0)
  pawtopiaRating Float    @default(0)
  availability   Boolean  @default(true)
  price          Int      // base / starting price in VND
  photo          String?  // main photo URL for listing page (we take first photo from mock)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Optional future relations (you can add later)
  // photos    HotelPhoto[]
  // rooms     Room[]
  // reviews   Review[]
}
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  price       Float
  imageUrl    String
  category    String
  createdAt   DateTime @default(now())
  stock       Int?
}

model Hotel {
  id             Int                      @id @default(autoincrement())
  name           String
  location       String
  description    String
  googleRating   Float                    @default(0)
  pawtopiaRating Float                    @default(0)
  availability   Boolean                  @default(true)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  basePrice      Int?
  amenities      HotelAmenity[]
  contact        HotelContactInformation?
  photos         HotelPhoto[]
  reviews        Review[]
  rooms          Room[]
  bookings       Booking[]
}

model HotelPhoto {
  id      Int    @id @default(autoincrement())
  hotelId Int
  url     String
  hotel   Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
}

model Amenity {
  id     Int            @id @default(autoincrement())
  name   String         @unique
  hotels HotelAmenity[]
}

model HotelAmenity {
  hotelId   Int
  amenityId Int
  amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  hotel     Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@id([hotelId, amenityId])
}

model HotelContactInformation {
  id      Int    @id @default(autoincrement())
  hotelId Int    @unique
  phone   String
  email   String
  hotel   Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
}

model Room {
  id           Int                @id @default(autoincrement())
  hotelId      Int
  type         String
  price        Int
  description  String
  hotel        Hotel              @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  availability RoomAvailability[]
}

model RoomAvailability {
  id        Int      @id @default(autoincrement())
  roomId    Int
  startDate DateTime
  endDate   DateTime
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model Review {
  id      Int      @id @default(autoincrement())
  hotelId Int
  user    String
  rating  Int
  comment String?
  date    DateTime @default(now())
  hotel   Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
}

model Booking {
  id      Int   @id @default(autoincrement())
  hotelId Int
  hotel   Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  roomType   String
  startDate  DateTime
  endDate    DateTime
  numCats    Int
  totalPrice Int

  fullName        String
  email           String
  phone           String
  specialRequests String?

  status String @default("Confirmed") // Confirmed, Pending, Cancelled

  createdAt DateTime @default(now())

  @@index([email])
}

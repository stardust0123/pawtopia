generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  price       Float
  imageUrl    String
  category    String
  createdAt   DateTime @default(now())
  stock       Int?
}

enum Role {
  USER
  ADMIN
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  policies Policy[]
}

model Hotel {
  id             Int                      @id @default(autoincrement())
  name           String
  location       String
  description    String
  googleRating   Float                    @default(0)
  pawtopiaRating Float                    @default(0)
  availability   Boolean                  @default(true)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  basePrice      Int?

  amenities      HotelAmenity[]
  contact        HotelContactInformation?
  photos         HotelPhoto[]
  reviews        Review[]
  rooms          Room[]
  bookings       Booking[]
}

model HotelPhoto {
  id      Int    @id @default(autoincrement())
  hotelId Int
  url     String

  hotel   Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
}

model Amenity {
  id     Int            @id @default(autoincrement())
  name   String         @unique
  hotels HotelAmenity[]
}

model HotelAmenity {
  hotelId   Int
  amenityId Int

  amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  hotel     Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@id([hotelId, amenityId])
}

model HotelContactInformation {
  id      Int    @id @default(autoincrement())
  hotelId Int    @unique
  phone   String
  email   String

  hotel   Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
}

model Room {
  id           Int                @id @default(autoincrement())
  hotelId      Int
  type         String
  price        Int
  description  String

  hotel        Hotel              @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  availability RoomAvailability[]
}

model RoomAvailability {
  id        Int      @id @default(autoincrement())
  roomId    Int
  startDate DateTime
  endDate   DateTime

  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model Review {
  id      Int      @id @default(autoincrement())
  hotelId Int
  user    String
  rating  Int
  comment String?
  date    DateTime @default(now())

  hotel   Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
}

model Booking {
  id                    Int      @id @default(autoincrement())
  hotelId               Int
  hotel                 Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  
  roomType              String
  startDate             DateTime
  endDate               DateTime
  numCats               Int
  totalPrice            Int
  
  fullName              String
  email                 String
  phone                 String
  specialRequests       String?
  
  status                String   @default("Pending")     // Changed from "Confirmed"
  
  // ── NEW STRIPE FIELDS ──
  stripePaymentIntentId String?                          // e.g. "pi_3..."
  paid                  Boolean  @default(false)

  createdAt             DateTime @default(now())

  @@index([email])
}

// ── CAT INSURANCE MODELS ──
model InsuranceProvider {
  id          Int             @id @default(autoincrement())
  name        String
  logoUrl     String?
  description String?
  plans       InsurancePlan[]
}

model InsurancePlan {
  id               Int               @id @default(autoincrement())
  providerId       Int
  name             String
  description      String
  monthlyPremium   Float
  annualPremium    Float
  coverageAmount   Int               // maximum payout
  keyFeatures      String[]          // e.g. ["Accident", "Illness", "Dental"]
  provider         InsuranceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  policies         Policy[]
}

model Policy {
  id                    Int           @id @default(autoincrement())
  userId                Int
  planId                Int
  catName               String
  catBreed              String
  catAge                Int
  medicalHistory        String?       // optional notes
  startDate             DateTime
  endDate               DateTime
  status                String        @default("Active")
  stripePaymentIntentId String?
  paid                  Boolean       @default(false)
  createdAt             DateTime      @default(now())

  user                  User          @relation(fields: [userId], references: [id])
  plan                  InsurancePlan @relation(fields: [planId], references: [id])
  claims                Claim[]
}

model Claim {
  id          Int      @id @default(autoincrement())
  policyId    Int
  description String
  amount      Float?
  status      String   @default("Pending")   // Pending, Approved, Rejected
  submittedAt DateTime @default(now())

  policy      Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
}


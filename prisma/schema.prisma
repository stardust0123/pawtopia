generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  price       Float
  imageUrl    String
  category    String
  createdAt   DateTime @default(now())
  stock       Int?
}

enum Role {
  USER
  ADMIN
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
}

model Amenity {
  id           Int            @id @default(autoincrement())
  name         String         @unique
  HotelAmenity HotelAmenity[]
}

model Booking {
  id              Int      @id @default(autoincrement())
  hotelId         Int
  roomType        String
  startDate       DateTime
  endDate         DateTime
  numCats         Int
  totalPrice      Int
  fullName        String
  email           String
  phone           String
  specialRequests String?
  status          String   @default("Confirmed")
  createdAt       DateTime @default(now())
  Hotel           Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([email])
}

model Hotel {
  id                      Int                      @id @default(autoincrement())
  name                    String
  location                String
  description             String
  googleRating            Float                    @default(0)
  pawtopiaRating          Float                    @default(0)
  availability            Boolean                  @default(true)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime
  basePrice               Int?
  Booking                 Booking[]
  HotelAmenity            HotelAmenity[]
  HotelContactInformation HotelContactInformation?
  HotelPhoto              HotelPhoto[]
  Review                  Review[]
  Room                    Room[]
}

model HotelAmenity {
  hotelId   Int
  amenityId Int
  Amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  Hotel     Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@id([hotelId, amenityId])
}

model HotelContactInformation {
  id      Int    @id @default(autoincrement())
  hotelId Int    @unique
  phone   String
  email   String
  Hotel   Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
}

model HotelPhoto {
  id      Int    @id @default(autoincrement())
  hotelId Int
  url     String
  Hotel   Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
}

model Review {
  id      Int      @id @default(autoincrement())
  hotelId Int
  user    String
  rating  Int
  comment String?
  date    DateTime @default(now())
  Hotel   Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
}

model Room {
  id               Int                @id @default(autoincrement())
  hotelId          Int
  type             String
  price            Int
  description      String
  Hotel            Hotel              @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  RoomAvailability RoomAvailability[]
}

model RoomAvailability {
  id        Int      @id @default(autoincrement())
  roomId    Int
  startDate DateTime
  endDate   DateTime
  Room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
}
